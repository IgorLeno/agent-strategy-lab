#!/usr/bin/env node
// CLI OpenCode FALSA — mesma função das fake `claude`/`codex`: exercitar o
// spawn real do preflight (`opencode providers list` é local e gratuito) sem
// gastar franquia e sem depender da conta da máquina. O cenário vem de
// AGENTLAB_FAKE_AUTH. Ela NUNCA roda um modelo: qualquer invocação que não
// seja `--help` ou `providers list` sai com erro, para que um teste que
// "quase" fez um run pago falhe de forma visível.
const args = process.argv.slice(2);
const scenario = process.env.AGENTLAB_FAKE_AUTH ?? 'subscription';

if (args.includes('--help') || args[0] === 'help') {
  process.stdout.write('fake opencode 9.9.9\nOptions:\n--format\n--model\n');
  process.exit(0);
}

if (args[0] === 'providers' && args[1] === 'list') {
  if (scenario === 'logged_out') {
    process.stdout.write('No providers configured\n');
    process.exit(0);
  }
  // Nome + tipo de credencial, como o `providers list` real: nunca a própria
  // credencial. OpenCode Go autentica assinatura por CHAVE, não por OAuth.
  process.stdout.write('OpenCode Go  api-key\n');
  process.exit(0);
}

process.stderr.write('fake opencode: run pago não é permitido em teste\n');
process.exit(70);
